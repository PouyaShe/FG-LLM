generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum RoomStatus {
  SCHEDULED
  ACTIVE
  ENDED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  role          Role      @default(STUDENT)
  avatar        String?
  refreshToken    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  roomsCreated  Room[]    @relation("TeacherRooms")
  enrollments   Enrollment[]
  files         File[]
  recordings    Recording[]
  logs          Log[]

  @@index([email])
  @@index([role])
}

model Room {
  id          String     @id @default(cuid())
  name        String
  description String?
  teacherId   String
  teacher     User       @relation("TeacherRooms", fields: [teacherId], references: [id])
  status      RoomStatus @default(SCHEDULED)
  startTime   DateTime?
  endTime     DateTime?
  maxParticipants Int    @default(50)
  isRecording Boolean    @default(false)
  recordingId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  enrollments Enrollment[]
  files       File[]
  recordings  Recording[]
  logs        Log[]

  @@index([teacherId])
  @@index([status])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  attended  Boolean  @default(false)

  @@unique([userId, roomId])
  @@index([roomId])
}

model File {
  id        String   @id @default(cuid())
  name      String
  url       String
  mimeType  String
  size      Int
  uploaderId String
  uploader   User    @relation(fields: [uploaderId], references: [id])
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id])
  createdAt DateTime @default(now())

  @@index([roomId])
  @@index([uploaderId])
}

model Recording {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  url       String
  duration  Int?
  size      Int?
  recordedBy String
  recordedByUser User @relation(fields: [recordedBy], references: [id])
  createdAt DateTime @default(now())

  @@index([roomId])
}

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  date      DateTime @default(now())
  present   Boolean  @default(true)
  joinTime  DateTime?
  leaveTime DateTime?

  @@unique([userId, roomId, date])
  @@index([roomId])
}

model Log {
  id        String   @id @default(cuid())
  level     String   @default("INFO")
  message   String
  metadata  Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id])
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

model TurnCredential {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
